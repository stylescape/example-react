{
    "name": "stylescape-example-react",
    "description": "Stylescape example with React and Vite",
    "version": "0.0.2",
    "private": true,
    "repository": "https://github.com/stylescape/example-react",
    "license": "MIT",
    "engines": {
        "node": ">=22.0.0"
    },
    "stackblitz": {
        "startCommand": "npm start"
    },
    "scripts": {
        "dev": "vite",
        "start": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "lint:css": "stylelint \"src/**/*.{css,scss}\"",
        "format": "prettier --write \"src/**/*.{js,ts,jsx,tsx,css,scss,html,json}\"",
        "test": "npm run build"
    },
    "dependencies": {
        "react": "^19.2.4",
        "react-dom": "^19.2.5",
        "stylescape": "^0.3.18"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^5.1.4",
        "prettier": "^3.8.3",
        "sass": "^1.99.0",
        "stylelint": "^16.18.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "vite": "^8.0.10"
    }
}
